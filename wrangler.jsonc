/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wild-idea-zone",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		/**
		 * Only /api/* invokes the Worker; everything else is served as static assets, which are
		 * free and don't count toward the Workers Free daily request limit. The bare domain is
		 * redirected to www by a Redirect Rule on the wildideazone.com zone, not by the Worker.
		 */
		"run_worker_first": ["/api/*"]
	},
	"routes": [
		{ "pattern": "www.wildideazone.com", "custom_domain": true },
		{ "pattern": "wildideazone.com", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true
}
