/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wild-idea-zone",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		/**
		 * Every request goes through the Worker so the bare domain can be redirected to www.
		 * This makes static asset requests count as Worker invocations; switch to ["/api/*"]
		 * and use a Cloudflare Redirect Rule for the apex if that ever matters.
		 */
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "www.wildideazone.com", "custom_domain": true },
		{ "pattern": "wildideazone.com", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true
}
